---
import { getLangFromUrl, getLocalizedPath, useTranslations } from "../../i18n/utils";

// Modular CSS Import
import "../../styles/components/buttons.css";
import "../../styles/sections/maincta.css";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pagePath = (path: string) => getLocalizedPath(lang, path);
---

<section class="section-cta" id="mainCTA">
  <div class="section-container cta-layout" data-animate="fade-up" data-threshold="0.2">
    <div class="cta-heading-block">
      <p class="cta-label">{t("cta.badge")}</p>
      <h2 class="cta-heading">{t("cta.title")}</h2>
    </div>

    <div class="cta-content">
      <p class="cta-subtitle">{t("cta.subtitle")}</p>

      <div class="cta-actions">
        <a href={pagePath("/project")} class="btn-primary">
          {t("cta.project")} <span aria-hidden="true">→</span>
        </a>
        <p class="cta-email">
          {t("cta.email_intro")}
          <a href="mailto:toni@fronta.hr">toni@fronta.hr</a>
        </p>
      </div>
    </div>
  </div>
</section>
