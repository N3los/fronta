---
import { getLangFromUrl, getLocalizedPath, useTranslations } from "../../i18n/utils";

// Modular CSS Imports
import "../../styles/components/cards.css";
import "../../styles/components/badges.css";
import "../../styles/sections/services.css";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pagePath = (path: string) => getLocalizedPath(lang, path);
---

<section class="section-services" id="Services">
  <div class="section-container relative z-10">
    <!-- Section Badge & Title -->
    <header
      class="mb-14 md:mb-20"
      data-animate="fade-right"
      data-threshold="0.5"
      data-margin="-150px"
    >
      <div class="index-marker mb-8">
        <div class="index-marker">
          <span class="index-num">02</span>
          <span class="index-line"></span>
        </div>
        <p class="badge-mono">{t("services.badge")}</p>
      </div>

      <h2 class="section-title">
        {t("services.title_base")}
        <span class="text-gradient-logo">{t("services.title_red")}</span>
      </h2>
    </header>

    <div class="services-grid">
      <!-- Practice 01: Websites -->
      <article
        class="service-card radiant-card group"
        data-animate="fade-up"
        data-threshold="0.5"
        data-margin="-150px"
      >
        <div class="relative z-10">
          <div class="mb-8 flex items-start justify-between md:mb-12">
            <p class="badge-mono text-fronta-red">/ {t("services.p1.label")}</p>
            <span class="badge-mono opacity-50">01</span>
          </div>

          <h3 class="card-title">{t("services.p1.title")}</h3>
          <p class="mb-8 max-w-md md:mb-10">
            {t("services.p1.desc")}
          </p>

          <ul class="service-feature-list">
            {
              [
                t("services.p1.feat1"),
                t("services.p1.feat2"),
                t("services.p1.feat3"),
              ].map((feat) => (
                <li class="service-feature-item">
                  <span class="red-dot" />
                  {feat}
                </li>
              ))
            }
          </ul>

          <a
            href={pagePath("/services#websites")}
            class="card-footer-cta group/link"
          >
            {t("services.p1.cta")}
            <span
              class="transition-transform duration-300 group-hover/link:translate-x-1"
              >→</span
            >
          </a>
        </div>
      </article>

      <!-- Practice 02: Apps -->
      <article
        class="service-card radiant-card group"
        data-animate="fade-up"
        data-margin="-150px"
        data-delay="200"
      >
        <div class="relative z-10">
          <div class="mb-8 flex items-start justify-between md:mb-12">
            <p class="badge-mono text-fronta-red">/ {t("services.p2.label")}</p>
            <span class="badge-mono opacity-50">02</span>
          </div>

          <h3 class="card-title">{t("services.p2.title")}</h3>
          <p class="mb-8 max-w-md md:mb-10">
            {t("services.p2.desc")}
          </p>

          <ul class="service-feature-list">
            {
              [
                t("services.p2.feat1"),
                t("services.p2.feat2"),
                t("services.p2.feat3"),
              ].map((feat) => (
                <li class="service-feature-item">
                  <span class="red-dot" />
                  {feat}
                </li>
              ))
            }
          </ul>

          <a
            href={pagePath("/services#applications")}
            class="card-footer-cta group/link"
          >
            {t("services.p2.cta")}
            <span
              class="transition-transform duration-300 group-hover/link:translate-x-1"
              >→</span
            >
          </a>
        </div>
      </article>
    </div>

  </div>
</section>

<script>
  import { initRadiantCards } from "../../scripts/radiantCards";
  initRadiantCards();
</script>
