---
import { languages } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="flex items-center gap-3 text-[10px] font-mono tracking-widest uppercase">
  {Object.entries(languages).map(([code, label]) => (
    <a 
      href={code === 'en' ? (base || '/') : `${base}/${code}`}
      class={`hover:text-fronta-red transition-colors ${lang === code ? 'text-white font-bold underline underline-offset-4 decoration-fronta-red' : 'text-fronta-muted'}`}
    >
      {code}
    </a>
  ))}
</div>
