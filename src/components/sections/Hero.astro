---
import { getLangFromUrl, getLocalizedPath, useTranslations } from "../../i18n/utils";

// Modular CSS Imports
import "../../styles/sections/hero.css";
import "../../styles/components/badges.css";
import "../../styles/components/buttons.css";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pagePath = (path: string) => getLocalizedPath(lang, path);
---

<section class="hero-section" id="Hero">
  <!-- Architectural Frame -->
  <div class="bracket-frame">
    <div class="corner-bracket corner-bracket-tl"></div>
    <div class="corner-bracket corner-bracket-tr"></div>
    <div class="corner-bracket corner-bracket-bl"></div>
    <div class="corner-bracket corner-bracket-br"></div>
  </div>

  <div class="section-container relative z-10 w-full text-center md:text-left">
    <div class="max-w-4xl mx-auto md:mx-0">
      <h1 class="hero-title" data-animate="blur-in" data-delay="300">
        <span class="text-gradient-logo">{t("hero.title_top")}</span><br />
        {t("hero.title_bottom")}
      </h1>

      <p class="hero-description" data-animate="blur-in" data-delay="500">
        {t("footer.copy")}
      </p>

      <div class="hero-actions" data-animate="blur-in" data-delay="700">
        <a href={pagePath("/project")} class="btn-primary group">
          {t("cta.project")}
          <span class="ml-2 transition-transform">→</span>
        </a>
        <a href={pagePath("/work")} class="btn-glass group">
          {t("hero.cta_websites")}
          <span class="ml-2 transition-transform">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
