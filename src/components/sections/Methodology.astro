---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

// Modular CSS Imports
import "../../styles/components/badges.css";
import "../../styles/sections/methodology.css";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="section-methodology" id="Methodology">
  <div class="section-container">
    <!-- Section Header -->
    <header
      class="methodology-section-header"
      data-animate="fade-right"
      data-threshold="0.5"
      data-margin="-150px"
    >
      <div class="index-marker mb-8">
        <div class="index-marker">
          <span class="index-num">03</span>
          <span class="index-line"></span>
        </div>
        <p class="badge-mono uppercase">{t("meth.badge")}</p>
      </div>

      <h2 class="section-title">
        {t("meth.title_top")} <br />
        <span class="text-gradient-logo">{t("meth.title_bottom")}</span>
      </h2>
      <p class="section-subtitle mt-6">
        {t("meth.subtitle")}
      </p>
    </header>

    <!-- 01 Understand -->
    <div class="methodology-row">
      <aside
        class="methodology-side"
        data-animate="fade-right"
        data-threshold="0.33"
      >
        <div class="methodology-sticky-header">
          <div class="methodology-index-large text-gradient-logo">01</div>
          <h3 class="methodology-side-title">{t("meth.p1.title")}</h3>
          <p class="badge-mono">{t("meth.p1.label")}</p>
        </div>
      </aside>

      <main class="methodology-content">
        <div
          class="methodology-blueprint-frame group"
          data-animate="fade-left"
          data-threshold="0.33"
        >
          <div class="service-card-grid">
            <div class="service-card-grid-inner opacity-10"></div>
          </div>

          <span class="methodology-detail-label">{t("meth.p1.detail_label")}</span>
          <h4 class="methodology-detail-title">{t("meth.p1.detail_title")}</h4>
          <p class="methodology-detail-desc">
            {t("meth.p1.detail_desc")}
          </p>

          <div class="methodology-list">
            <span class="methodology-list-item"
              ><i></i> {t("meth.p1.feat1")}</span
            >
            <span class="methodology-list-item"><i></i> {t("meth.p1.feat2")}</span>
            <span class="methodology-list-item"><i></i> {t("meth.p1.feat3")}</span>
            <span class="methodology-list-item"
              ><i></i> {t("meth.p1.feat4")}</span
            >
          </div>
        </div>
      </main>
    </div>

    <!-- 02 Structure -->
    <div class="methodology-row">
      <aside
        class="methodology-side"
        data-animate="fade-left"
        data-threshold="0.33"
      >
        <div class="methodology-sticky-header">
          <div class="methodology-index-large text-gradient-logo">02</div>
          <h3 class="methodology-side-title">{t("meth.p2.title")}</h3>
          <p class="badge-mono">{t("meth.p2.label")}</p>
        </div>
      </aside>

      <main class="methodology-content">
        <div
          class="methodology-blueprint-frame group"
          data-animate="fade-right"
          data-threshold="0.33"
        >
          <div class="service-card-grid">
            <div class="service-card-grid-inner rotate-3"></div>
          </div>

          <span class="methodology-detail-label">{t("meth.p2.detail_label")}</span>
          <h4 class="methodology-detail-title">{t("meth.p2.detail_title")}</h4>
          <p class="methodology-detail-desc">
            {t("meth.p2.detail_desc")}
          </p>

          <div class="methodology-list">
            <span class="methodology-list-item"><i></i> {t("meth.p2.feat1")}</span>
            <span class="methodology-list-item"><i></i> {t("meth.p2.feat2")}</span>
            <span class="methodology-list-item"
              ><i></i> {t("meth.p2.feat3")}</span
            >
            <span class="methodology-list-item"><i></i> {t("meth.p2.feat4")}</span>
          </div>
        </div>
      </main>
    </div>

    <!-- 03 Design -->
    <div class="methodology-row">
      <aside
        class="methodology-side"
        data-animate="fade-right"
        data-threshold="0.33"
      >
        <div class="methodology-sticky-header">
          <div class="methodology-index-large text-gradient-logo">03</div>
          <h3 class="methodology-side-title">{t("meth.p3.title")}</h3>
          <p class="badge-mono">{t("meth.p3.label")}</p>
        </div>
      </aside>

      <main class="methodology-content">
        <div
          class="methodology-blueprint-frame group"
          data-animate="fade-left"
          data-threshold="0.33"
        >
          <div class="service-card-grid">
            <div class="service-card-grid-inner -rotate-6 scale-110"></div>
          </div>

          <span class="methodology-detail-label">{t("meth.p3.detail_label")}</span>
          <h4 class="methodology-detail-title">{t("meth.p3.detail_title")}</h4>
          <p class="methodology-detail-desc">
            {t("meth.p3.detail_desc")}
          </p>

          <div class="methodology-list">
            <span class="methodology-list-item"><i></i> {t("meth.p3.feat1")}</span>
            <span class="methodology-list-item"><i></i> {t("meth.p3.feat2")}</span
            >
            <span class="methodology-list-item"><i></i> {t("meth.p3.feat3")}</span>
            <span class="methodology-list-item"><i></i> {t("meth.p3.feat4")}</span>
          </div>
        </div>
      </main>
    </div>

    <!-- 04 Ship -->
    <div class="methodology-row">
      <aside
        class="methodology-side"
        data-animate="fade-left"
        data-threshold="0.33"
      >
        <div class="methodology-sticky-header">
          <div class="methodology-index-large text-gradient-logo">04</div>
          <h3 class="methodology-side-title">{t("meth.p4.title")}</h3>
          <p class="badge-mono">{t("meth.p4.label")}</p>
        </div>
      </aside>

      <main class="methodology-content">
        <div
          class="methodology-blueprint-frame group"
          data-animate="fade-right"
          data-threshold="0.33"
        >
          <div class="service-card-grid">
            <div class="service-card-grid-inner"></div>
          </div>

          <span class="methodology-detail-label">{t("meth.p4.detail_label")}</span>
          <h4 class="methodology-detail-title">{t("meth.p4.detail_title")}</h4>
          <p class="methodology-detail-desc">
            {t("meth.p4.detail_desc")}
          </p>

          <div class="methodology-list">
            <span class="methodology-list-item"><i></i> {t("meth.p4.feat1")}</span>
            <span class="methodology-list-item"><i></i> {t("meth.p4.feat2")}</span>
            <span class="methodology-list-item"><i></i> {t("meth.p4.feat3")}</span>
            <span class="methodology-list-item"><i></i> {t("meth.p4.feat4")}</span>
          </div>
        </div>
      </main>
    </div>
  </div>
</section>
