---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';
import logo from '../assets/logo_full.svg';

// Modular CSS Import
import '../styles/components/footer.css';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const localizedPath = lang === 'en' ? '' : `/${lang}`;
---

<footer class="footer-reveal">
  <div class="footer-content">
    <div class="footer-grid">
      <!-- Brand & Status -->
      <div class="footer-info">
        <a href={base + localizedPath || '/'} class="footer-logo-link">
          <Image src={logo} alt="FRONTA" class="h-8 w-auto" />
        </a>
        <p class="footer-tagline">
          Freelance design and frontend practice building production-grade digital products for modern engineering teams.
        </p>
        
        <div class="footer-status">
          <span class="status-dot"></span>
          ACTIVE // AVAILABLE FOR Q3 2024
        </div>
      </div>
      
      <!-- Capabilities -->
      <nav class="footer-nav-col">
        <h4 class="footer-nav-title">Capabilities</h4>
        <ul class="footer-nav-list">
          <li><a href={`${base}${localizedPath}/work`} class="footer-nav-link">Selected Work</a></li>
          <li><a href={`${base}${localizedPath}/services`} class="footer-nav-link">Our Services</a></li>
          <li><a href={`${base}${localizedPath}/experts`} class="footer-nav-link">Expert Audit</a></li>
        </ul>
      </nav>

      <!-- Practice -->
      <nav class="footer-nav-col">
        <h4 class="footer-nav-title">Practice</h4>
        <ul class="footer-nav-list">
          <li><a href={`${base}${localizedPath}/about`} class="footer-nav-link">About Study</a></li>
          <li><a href={`${base}${localizedPath}/contact`} class="footer-nav-link">The Process</a></li>
          <li><a href="https://twitter.com/fronta" class="footer-nav-link">X / Twitter</a></li>
        </ul>
      </nav>

      <!-- Labs -->
      <nav class="footer-nav-col">
        <h4 class="footer-nav-title">Labs</h4>
        <ul class="footer-nav-list">
          <li><a href="#" class="footer-nav-link">Source Code</a></li>
          <li><a href="#" class="footer-nav-link">Experiments</a></li>
          <li><a href="#" class="footer-nav-link">Tools</a></li>
        </ul>
      </nav>
    </div>
    
    <!-- Bottom Metadata -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {new Date().getFullYear()} FRONTA PTY LTD. ALL RIGHTS RESERVED.
      </p>
      
      <div class="footer-legal-links">
        <a href={`${base}${localizedPath}/privacy`} class="footer-legal-link">Privacy</a>
        <a href={`${base}${localizedPath}/terms`} class="footer-legal-link">Terms</a>
        <a href="mailto:hello@fronta.studio" class="footer-legal-link">Email</a>
      </div>
    </div>
  </div>
</footer>
