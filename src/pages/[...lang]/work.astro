---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ProjectEntry from "../../components/work/ProjectEntry.astro";
import MainCTA from "../../components/sections/MainCTA.astro";
import PageHeading from "../../components/PageHeading.astro";
import { getProjectsByType } from "../../data/projects";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

import "/src/styles/pages/work.css";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "hr" } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const websiteProjects = getProjectsByType("website");
const appProjects = getProjectsByType("app");
---

<Layout title={t("meta.work.title")} description={t("meta.work.description")}>
  <main class="main-content-wrapper bg-dotted">
    <Navbar />

    <section class="page-hero">
      <div class="section-container">
        <PageHeading eyebrow={t("workPage.hero.eyebrow")} title={t("workPage.hero.title")} intro={t("workPage.hero.intro")}>
          <nav slot="actions" class="work-page-jump-nav" aria-label={t("workPage.hero.eyebrow")}>
            <a href="#websites">{t("workPage.websites.label")}</a>
            <a href="#applications">{t("workPage.apps.label")}</a>
          </nav>
        </PageHeading>
      </div>
    </section>

    <section class="work-page-group" id="websites">
      <div class="section-container">
        <header class="work-page-group-heading">
          <p class="page-kicker" data-animate="fade-right">
            {t("workPage.websites.label")}
          </p>
          <div data-animate="fade-up">
            <h2>{t("workPage.websites.title")}</h2>
            <p>{t("workPage.websites.intro")}</p>
          </div>
        </header>

        <div class="work-project-list">
          {websiteProjects.map((project, index) => (
            <ProjectEntry project={project} index={index} lang={lang} />
          ))}
        </div>
      </div>
    </section>

    <section class="work-page-group work-page-group--apps" id="applications">
      <div class="section-container">
        <header class="work-page-group-heading">
          <p class="page-kicker" data-animate="fade-right">
            {t("workPage.apps.label")}
          </p>
          <div data-animate="fade-up">
            <h2>{t("workPage.apps.title")}</h2>
            <p>{t("workPage.apps.intro")}</p>
          </div>
        </header>

        <div class="work-project-list">
          {appProjects.map((project, index) => (
            <ProjectEntry project={project} index={websiteProjects.length + index} lang={lang} />
          ))}
        </div>
      </div>
    </section>

    <MainCTA />
  </main>
  <Footer />
</Layout>
