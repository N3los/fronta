---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import "../../styles/components/marquee.css";

// Client Logos
import consumable from "../../assets/clients/consumable.png";
import dax from "../../assets/clients/dax.png";
import global from "../../assets/clients/global.png";
import kargo from "../../assets/clients/kargo.png";
import remixd from "../../assets/clients/remixd.png";
import videobyte from "../../assets/clients/videobyte.png";
import wcs from "../../assets/clients/wcs.png";

const logos = [
  { src: global, alt: "Global", height: 45, filter: "invert(1)" },
  { src: kargo, alt: "Kargo", height: 35, filter: "invert(1)" },
  { src: dax, alt: "DAX", height: 30, filter: "invert(1)" },
  {
    src: videobyte,
    alt: "VideoByte",
    height: 35,
    filter: "",
  },
  { src: consumable, alt: "Consumable", height: 35, filter: "brightness(1.1)" },
  { src: remixd, alt: "Remixd", height: 35, filter: "invert(1)" },
  { src: wcs, alt: "WCS", height: 40, filter: "brightness(1.1)" },
];

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="marquee-container">
  <p class="marquee-label">{t("marquee.label")}</p>
  <div class="marquee-stack">
    <!-- Single Unified Marquee Track -->
    <div class="marquee-content">
      <div class="marquee-track">
        <div class="marquee-logo-item" aria-hidden="true">
          {
            logos.map((logo) => (
              <div
                class="client-logo"
                style={logo.filter ? `filter: grayscale(1) ${logo.filter}` : ""}
              >
                <Image
                  src={logo.src}
                  alt=""
                  height={logo.height}
                  class="logo-img"
                />
              </div>
            ))
          }
        </div>
        <div class="marquee-logo-item" aria-hidden="true">
          {
            logos.map((logo) => (
              <div
                class="client-logo"
                style={logo.filter ? `filter: grayscale(1) ${logo.filter}` : ""}
              >
                <Image
                  src={logo.src}
                  alt=""
                  height={logo.height}
                  class="logo-img"
                />
              </div>
            ))
          }
        </div>
        <!-- Triple for smooth looping on large screens -->
        <div class="marquee-logo-item">
          {
            logos.map((logo) => (
              <div
                class="client-logo"
                style={logo.filter ? `filter: grayscale(1) ${logo.filter}` : ""}
              >
                <Image
                  src={logo.src}
                  alt={logo.alt}
                  height={logo.height}
                  class="logo-img"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
