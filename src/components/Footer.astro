---
import Button from './Button.astro';
---

<footer class="border-t border-fronta-border bg-fronta-dark pt-24 pb-12">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      <div class="md:col-span-2">
        <a href="/" class="text-2xl font-bold tracking-tight text-white mb-6 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-fronta-red"></span>
          FRONTA
        </a>
        <p class="text-fronta-muted text-sm max-w-sm mb-6 line-height-relaxed">
          FRONTA is a freelance design and frontend practice — building production-ready websites and apps for founders, product teams, and engineering.
        </p>
      </div>
      
      <div>
        <h4 class="text-white font-semibold mb-6">Capabilities</h4>
        <ul class="space-y-4">
          <li><a href="/work" class="text-sm text-fronta-muted hover:text-white transition-colors">Work</a></li>
          <li><a href="/services" class="text-sm text-fronta-muted hover:text-white transition-colors">Services</a></li>
          <li><a href="/experts" class="text-sm text-fronta-muted hover:text-white transition-colors">Experts</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold mb-6">Company</h4>
        <ul class="space-y-4">
          <li><a href="/about" class="text-sm text-fronta-muted hover:text-white transition-colors">About</a></li>
          <li><a href="/contact" class="text-sm text-fronta-muted hover:text-white transition-colors">Contact</a></li>
          <li><a href="https://twitter.com/fronta" class="text-sm text-fronta-muted hover:text-white transition-colors">Twitter</a></li>
        </ul>
      </div>
    </div>
    
    <div class="flex flex-col md:flex-row items-center justify-between pt-8 border-t border-fronta-border">
      <p class="text-xs text-fronta-muted mb-4 md:mb-0">
        &copy; {new Date().getFullYear()} FRONTA. All rights reserved.
      </p>
      <div class="flex gap-4">
        <a href="/privacy" class="text-xs text-fronta-muted hover:text-white">Privacy Policy</a>
        <a href="/terms" class="text-xs text-fronta-muted hover:text-white">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
