---
import { getLangFromUrl, getLocalizedPath, useTranslations } from "../i18n/utils";
import logo from "../assets/logo_new.svg";

import "../styles/components/footer.css";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pagePath = (path: string) => getLocalizedPath(lang, path);
---

<footer class="footer-main" id="site-footer">
  <div class="footer-content">
    <div class="footer-brand">
      <a href={pagePath("/")} class="footer-logo-link" aria-label="FRONTA">
        <img src={logo.src} alt="FRONTA" class="footer-logo" />
      </a>
      <p class="footer-description">{t("footer.tagline")}</p>
    </div>

    <nav class="footer-column" aria-labelledby="footer-navigation-title">
      <h2 id="footer-navigation-title" class="footer-heading">
        {t("footer.navigation")}
      </h2>
      <ul class="footer-links">
        <li><a href={pagePath("/work")}>{t("nav.work")}</a></li>
        <li><a href={pagePath("/services")}>{t("nav.services")}</a></li>
        <li><a href={pagePath("/process")}>{t("nav.process")}</a></li>
        <li><a href={pagePath("/about")}>{t("nav.about")}</a></li>
      </ul>
    </nav>

    <nav class="footer-column" aria-labelledby="footer-services-title">
      <h2 id="footer-services-title" class="footer-heading">
        {t("footer.capabilities")}
      </h2>
      <ul class="footer-links">
        <li><a href={`${pagePath("/services")}#websites`}>{t("footer.websites")}</a></li>
        <li><a href={`${pagePath("/services")}#applications`}>{t("footer.apps")}</a></li>
        <li><a href={`${pagePath("/services")}#b2b`}>{t("footer.b2b")}</a></li>
      </ul>
    </nav>

    <div class="footer-column footer-contact">
      <h2 class="footer-heading">{t("footer.connect")}</h2>
      <a class="footer-email" href="mailto:toni@fronta.hr">toni@fronta.hr</a>
      <a class="footer-project-link" href={pagePath("/project")}>
        {t("cta.project")} <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; 2017&ndash;{new Date().getFullYear()} FRONTA. {t("footer.rights")}</p>
    <nav class="footer-legal" aria-label={t("footer.legal")}>
      <a href={pagePath("/privacy")}>{t("footer.privacy")}</a>
      <a href={pagePath("/impressum")}>{t("footer.impressum")}</a>
    </nav>
  </div>
</footer>
