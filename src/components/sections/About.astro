---
import { getLangFromUrl, getLocalizedPath, useTranslations } from "../../i18n/utils";

// Modular CSS Import
import "../../styles/sections/about.css";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pagePath = (path: string) => getLocalizedPath(lang, path);
---

<section class="section-about" id="About">
  <div class="section-container">
    <div class="about-header-split">
      <!-- Side Marker -->
      <div class="md:col-span-4" data-animate="fade-right">
        <div class="index-marker mb-0 md:mb-12">
          <span class="index-num">04</span>
          <span class="index-line"></span>
          <p class="badge-mono uppercase">{t("about.badge")}</p>
        </div>
      </div>

      <!-- Content Block -->
      <div class="md:col-span-8 flex flex-col" data-animate="fade-up" data-delay="200">
        <h2 class="about-title">
          {t("about.title_top")}
          <span class="text-gradient-logo">{t("about.title_bottom")}</span>
        </h2>

        <p class="about-meta">
          {t("about.desc")}
        </p>

        <a href={pagePath("/about")} class="about-link">
          {t("about.link")} <span>→</span>
        </a>
      </div>
    </div>
  </div>
</section>
