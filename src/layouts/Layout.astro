---
import '../styles/global.css';

import { getLangFromUrl } from '../i18n/utils';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Websites and apps, built right. FRONTA is a freelance design and frontend practice." } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		
    <!-- Canonical URL -->
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}

		<!-- Google Fonts: Inter & Space Grotesk -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
		
		<title>{title}</title>
	</head>
	<body>
    <main class="main-content-wrapper">
		  <slot />
    </main>
    <script src="../scripts/animations.js"></script>
	</body>
</html>
