---
import { languages } from "../i18n/ui";
import { getLangFromUrl, getLocalizedPath, getRelativePathWithoutLang } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const otherLang = lang === "en" ? "hr" : "en";
const pathWithoutLang = getRelativePathWithoutLang(Astro.url);
const targetPath = getLocalizedPath(otherLang, pathWithoutLang);
---

<a
  href={targetPath}
  class="btn-pill text-[9px] font-bold tracking-[0.2em] uppercase transition-colors duration-300"
>
  {otherLang}
</a>
