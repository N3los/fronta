---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

// Sections
import Hero from "../../components/sections/Hero.astro";
import Services from "../../components/sections/Services.astro";
import Methodology from "../../components/sections/Methodology.astro";
import Portfolio from "../../components/sections/Portfolio.astro";
import Marquee from "../../components/sections/Marquee.astro";
import About from "../../components/sections/About.astro";
import MainCTA from "../../components/sections/MainCTA.astro";

import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: "hr" } },
    // Add other languages here if needed: { params: { lang: 'de' } }
  ];
}

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<Layout title={t("meta.home.title")} description={t("meta.home.description")}>
  <main class="main-content-wrapper bg-dotted">
    <Navbar />

    <Hero />
    <Marquee />
    <Portfolio />
    <Services />
    <Methodology />
    <About />
    <MainCTA />
  </main>
  <Footer />
</Layout>
