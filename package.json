{
  "name": "web26",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:production": "astro build",
    "audit:seo": "node src/scripts/seo-audit.js",
    "release:check": "npm run build:production && npm run audit:seo",
    "build:staging": "node src/scripts/build-staging.js",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "npm run deploy:production",
    "deploy:staging:dry": "npm run build:staging && node src/scripts/deploy.js --target=staging --dry-run",
    "deploy:staging": "npm run build:staging && node src/scripts/deploy.js --target=staging",
    "deploy:production:dry": "npm run build:production && node src/scripts/deploy.js --target=production --dry-run",
    "deploy:production": "npm run build:production && node src/scripts/deploy.js --target=production --confirm-production"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@barba/core": "^2.10.3",
    "@tailwindcss/vite": "^4.2.3",
    "astro": "^6.1.8",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "tailwindcss": "^4.2.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "basic-ftp": "^5.3.0"
  }
}
