---
import Button from './Button.astro';
---

<header class="fixed top-0 w-full z-50 bg-fronta-dark/80 backdrop-blur-md border-b justify-center border-fronta-border">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <div class="flex-shrink-0">
      <a href="/" class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
        <!-- Optional logo icon, using simple red dot for now -->
        <span class="w-2 h-2 rounded-full bg-fronta-red"></span>
        FRONTA
      </a>
    </div>
    
    <nav class="hidden md:flex items-center gap-8">
      <a href="/experts" class="nav-link">Experts</a>
      <a href="/work" class="nav-link">Work</a>
      <a href="/services" class="nav-link">Services</a>
      <a href="/about" class="nav-link">About</a>
    </nav>
    
    <div class="hidden md:flex">
      <Button href="/contact" variant="secondary" className="!py-2 !px-4 text-xs">
        Book an introductory call
      </Button>
    </div>

    <!-- Mobile menu button -->
    <button class="md:hidden text-fronta-muted hover:text-white" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    </button>
  </div>
</header>
